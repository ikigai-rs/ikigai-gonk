# The Dashboard lens (workspace.md section 7, proposal 15; ledger #3959): the open and in-flight
# items of the ledger whose graph is ?focus (`urn:iki:ledger:graph:{ledger}`), in-flight first,
# then by number. Each row's ?item is the item's IRI, so a workspace pane over this lens that
# `emits` `item` sets that role from the row. A new lens beside the XSLT Dashboard, not a port.
PREFIX ledger: <https://ikigai-rs.dev/ns/ledger#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?focus ?item ?number ?title ?state ?holder WHERE {
  GRAPH ?focus {
    ?item a ledger:Item ;
          ledger:status ledger:open ;
          ledger:number ?number ;
          dcterms:title ?title .
    OPTIONAL { ?item ledger:claimedBy ?claimedBy }
  }
  BIND(IF(BOUND(?claimedBy), "in flight", "open") AS ?state)
  BIND(COALESCE(STR(?claimedBy), "") AS ?holder)
}
ORDER BY ?state ?number

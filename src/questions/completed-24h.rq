# Items closed done in the last 24 hours whose last hand-back was by this holder.
PREFIX ledger: <https://ikigai-rs.dev/ns/ledger#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?number ?closedAt ?title WHERE {
  ?item a ledger:Item ;
        ledger:status ledger:closed ;
        ledger:closedReason ledger:done ;
        ledger:closedAt ?closedAt ;
        ledger:number ?number ;
        dcterms:title ?title .
  FILTER(?closedAt >= ?since)
  ?handback ledger:onItem ?item ;
            ledger:handedBackBy ?holder ;
            dcterms:created ?last .
  {
    SELECT ?item (MAX(?at) AS ?last) WHERE {
      ?any ledger:handedBackBy ?anyone ;
           ledger:onItem ?item ;
           dcterms:created ?at .
    }
    GROUP BY ?item
  }
}
ORDER BY DESC(?closedAt) ?number

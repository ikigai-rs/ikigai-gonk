# Items this holder holds now.
PREFIX ledger: <https://ikigai-rs.dev/ns/ledger#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?number ?title WHERE {
  ?item a ledger:Item ;
        ledger:claimedBy ?holder ;
        ledger:claimedAt ?claimed ;
        ledger:number ?number ;
        dcterms:title ?title .
}
ORDER BY ?number

# QUESTION: Which items were closed as done with no evidence on their close?
# A query sensor (ledger #3726): it fires while one row stands. A done close names what
# closed it (`close evidence=<commit, pull request or test>`, ledger:evidence on the close's
# StatusEvent); one that names nothing is a claim of work nobody can check.
PREFIX ledger: <https://ikigai-rs.dev/ns/ledger#>
SELECT ?item ?number
FROM <urn:iki:ledger:graph:default>
WHERE {
  ?item a ledger:Item ;
        ledger:number ?number ;
        ledger:status ledger:closed ;
        ledger:closedReason ledger:done .
  FILTER NOT EXISTS {
    ?close a ledger:StatusEvent ;
           ledger:onItem ?item ;
           ledger:status ledger:closed ;
           ledger:evidence ?evidence .
  }
}
ORDER BY ?number
